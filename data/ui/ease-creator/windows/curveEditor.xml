<window
    title="Curve Editor"
    width="300"
    draggable="false"
    closable="false"
    minimizable="false"
    maximizable="false"
    collapsable="false">

    <vbox width="100%" padding="5">

        <label text="Custom Ease Editor"/>

        <spacer height="5"/>

        <label text="Ease Name"/>

    <textfield
        id="easeName"
        width="200"
        text="Ease Name" />

    <label text="Easing Direction"/>

    <dropdown
        id="easeDirection"
        width="200" />

        <button
            id="addPoint"
            text="Add Point"
            width="100%"/>

        <button
            id="deletePoint"
            text="Delete Point"
            width="100%"/>

        <spacer height="5"/>

        <label text="Selected Point"/>

        <number-stepper
            id="pointX"
            width="100%"
            min="0"
            max="1"
            step="0.01"/>

        <number-stepper
            id="pointY"
            width="100%"
            min="0"
            max="1"
            step="0.01"/>

        <spacer height="5"/>

        <checkbox
            id="curveMode"
            text="Curve Mode"/>

        <spacer height="5"/>

        <button
            id="saveCurve"
            text="Save Curve"
            width="100%"/>

        <button
            id="loadCurve"
            text="Load Curve"
            width="100%"/>

    </vbox>
</window>